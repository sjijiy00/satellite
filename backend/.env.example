# Loaded only by scripts/start-local.mjs into the backend process.
# Never put a real credential in this example or NEXT_PUBLIC variables.
# Public Pages site origin, e.g. https://your-project.pages.dev (no trailing slash).
# Enables anonymous media/job origin checks only; not public Earthdata OAuth.
PUBLIC_APP_ORIGIN=
AI_NL_ENABLED=1
AI_NL_PROVIDER=openai
AI_NL_MODEL=gpt-4o
OPENAI_API_KEY=
AI_NL_INPUT_USD_PER_MILLION=
AI_NL_OUTPUT_USD_PER_MILLION=
# Only after registering this application with Earthdata Login.
# The redirect URI must exactly match the registered callback.
EARTHDATA_CLIENT_ID=
EARTHDATA_CLIENT_SECRET=
EARTHDATA_REDIRECT_URI=
# Default: memory only, maximum 8 hours. Unset/0 does not restore or save grants.
# Explicitly set to 1 to opt into local user-scope Windows DPAPI persistence.
# Maximum 30 days; provider expiry/revocation still applies. Single server process only.
# Stored under backend/.private/earthdata; no passwords or personal User Tokens here.
# Legacy/other-app stores require manual protected isolation; never auto-migrated/deleted.
# Preserve the whole folder (DB and revocations) when isolating; verify NASA revocation separately.
EARTHDATA_PERSIST_SESSIONS=

# Optional Kakao administrative place lookup. Server only; disabled until configured.
GEOCODER_ENABLED=0
KAKAO_LOCAL_REST_API_KEY=

# Operator access (disabled until separately prepared and reviewed by the operator).
# Never paste real values in this example. Server backend/.env only, never NEXT_PUBLIC.
OPERATOR_ACCESS_ENABLED=0
OPERATOR_PUBLIC_ORIGIN=http://127.0.0.1:3000
OPERATOR_WORKERS=1
# Optional OPERATOR_STORE_PATH: protected server path; default backend/.private/operator/access.sqlite3
OPERATOR_USGS_ENABLED=0
OPERATOR_USGS_REVISION=1
OPERATOR_USGS_REDISTRIBUTION_REVIEWED=0
OPERATOR_USGS_USERNAME=
OPERATOR_USGS_APPLICATION_TOKEN=
OPERATOR_CDSE_ENABLED=0
OPERATOR_CDSE_REVISION=1
OPERATOR_CDSE_REDISTRIBUTION_REVIEWED=0
OPERATOR_CDSE_USERNAME=
OPERATOR_CDSE_PASSWORD=
# Optional official refresh token from the operator's approved/2FA authentication.
OPERATOR_CDSE_REFRESH_TOKEN=
OPERATOR_NASA_ENABLED=0
OPERATOR_NASA_REVISION=1
OPERATOR_NASA_REDISTRIBUTION_REVIEWED=0
OPERATOR_NASA_USER_TOKEN=
# Issuer-provided expiration, Unix seconds UTC. Never infer unlimited token validity.
OPERATOR_NASA_TOKEN_EXPIRES_AT=

# HLS operator access: keep disabled until product terms review and approval.
# Existing NASA token/expiry variables above remain server-only.
OPERATOR_NASA_COLLECTIONS=viirs-vnp09ga-002
OPERATOR_NASA_HLS_REDISTRIBUTION_REVIEWED=0
AI_NL_TIMEOUT_SECONDS=45
AI_NL_MAX_OUTPUT_TOKENS=4000
AI_NL_REQUESTS_PER_MINUTE=6
AI_NL_REQUESTS_PER_PROCESS=100
